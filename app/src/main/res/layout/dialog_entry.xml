<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="8dp"
    android:paddingEnd="20dp"
    android:paddingBottom="4dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/f_title"
        android:textColor="@color/muted"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/dlgTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_edit"
        android:hint="@string/hint_title"
        android:inputType="text"
        android:maxLines="1"
        android:padding="13dp"
        android:textColor="@color/text"
        android:textColorHint="@color/muted"
        android:textSize="15sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/f_user"
        android:textColor="@color/muted"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/dlgUser"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_edit"
        android:inputType="text"
        android:maxLines="1"
        android:padding="13dp"
        android:textColor="@color/text"
        android:textSize="15sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/f_password"
        android:textColor="@color/muted"
        android:textSize="13sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp">

        <EditText
            android:id="@+id/dlgPw"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_edit"
            android:inputType="textPassword"
            android:padding="13dp"
            android:paddingEnd="48dp"
            android:textColor="@color/text"
            android:textSize="15sp" />

        <ImageButton
            android:id="@+id/dlgEye"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="6dp"
            android:background="@null"
            android:contentDescription="@string/cd_show_pw"
            android:src="@drawable/ic_eye"
            android:tint="@color/muted" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="end"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/dlgGen"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_icon_btn"
            android:contentDescription="@string/cd_random"
            android:src="@drawable/ic_refresh"
            android:tint="@color/accent" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <View
            android:id="@+id/dlgStr0"
            android:layout_width="0dp"
            android:layout_height="5dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:background="@color/strength_off" />

        <View
            android:id="@+id/dlgStr1"
            android:layout_width="0dp"
            android:layout_height="5dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:background="@color/strength_off" />

        <View
            android:id="@+id/dlgStr2"
            android:layout_width="0dp"
            android:layout_height="5dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:background="@color/strength_off" />

        <View
            android:id="@+id/dlgStr3"
            android:layout_width="0dp"
            android:layout_height="5dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:background="@color/strength_off" />

        <TextView
            android:id="@+id/dlgStrLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:minWidth="96dp"
            android:text="—"
            android:textAlignment="viewEnd"
            android:textColor="@color/muted"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/f_url"
        android:textColor="@color/muted"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/dlgUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_edit"
        android:hint="@string/hint_url"
        android:inputType="textUri"
        android:maxLines="1"
        android:padding="13dp"
        android:textColor="@color/text"
        android:textColorHint="@color/muted"
        android:textSize="15sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/f_notes"
        android:textColor="@color/muted"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/dlgNotes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_edit"
        android:gravity="top"
        android:hint="@string/hint_notes"
        android:inputType="textMultiLine"
        android:minLines="2"
        android:padding="13dp"
        android:textColor="@color/text"
        android:textColorHint="@color/muted"
        android:textSize="15sp" />
</LinearLayout>
