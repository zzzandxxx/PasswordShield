<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="8dp"
    android:paddingEnd="20dp"
    android:paddingBottom="4dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dlg_cp_cur"
        android:textColor="@color/muted"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/cpCur"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_edit"
        android:inputType="textPassword"
        android:padding="13dp"
        android:textColor="@color/text"
        android:textSize="15sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/dlg_cp_new"
        android:textColor="@color/muted"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/cpNew"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_edit"
        android:inputType="textPassword"
        android:padding="13dp"
        android:textColor="@color/text"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <View
            android:id="@+id/cpStr0"
            android:layout_width="0dp"
            android:layout_height="5dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:background="@color/strength_off" />

        <View
            android:id="@+id/cpStr1"
            android:layout_width="0dp"
            android:layout_height="5dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:background="@color/strength_off" />

        <View
            android:id="@+id/cpStr2"
            android:layout_width="0dp"
            android:layout_height="5dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:background="@color/strength_off" />

        <View
            android:id="@+id/cpStr3"
            android:layout_width="0dp"
            android:layout_height="5dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:background="@color/strength_off" />

        <TextView
            android:id="@+id/cpStrLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:minWidth="96dp"
            android:text="—"
            android:textAlignment="viewEnd"
            android:textColor="@color/muted"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/dlg_cp_new2"
        android:textColor="@color/muted"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/cpNew2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_edit"
        android:inputType="textPassword"
        android:padding="13dp"
        android:textColor="@color/text"
        android:textSize="15sp" />
</LinearLayout>
